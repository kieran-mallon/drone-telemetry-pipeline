{
  "name": "drone-telemetry-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Event-driven ingestion pipeline for autonomous drone telemetry",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "migrate": "tsx src/adapters/postgres/migrate.ts",
    "start:processor": "tsx src/runtime/poller.ts",
    "start:api": "tsx src/runtime/api.ts",
    "seed": "tsx scripts/seed.ts",
    "send:file": "tsx scripts/send-sample.ts file",
    "send:message": "tsx scripts/send-sample.ts message"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/client-sqs": "^3.1128.0",
    "fastify": "^5.12.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/aws-lambda": "^8.10.155",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "eslint": "^10.10.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
