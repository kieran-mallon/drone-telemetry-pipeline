# ---------------------------------------------------------------------------
# Copy to .env for local development. docker-compose.yml already sets these
# for the containers; this file is for running the processor or API on the host.
# ---------------------------------------------------------------------------

# Postgres
DATABASE_URL=postgres://drone:drone@localhost:5432/telemetry

# AWS / LocalStack. AWS_ENDPOINT_URL is what makes the SDK talk to LocalStack
# instead of real AWS. Leave it unset in a real deployment.
AWS_REGION=eu-west-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Pipeline wiring
RAW_BUCKET=drone-telemetry-raw
INGEST_QUEUE_URL=http://localhost:4566/000000000000/drone-telemetry-ingest

# Tuning
BATCH_SIZE=10
MAX_RECORDS_PER_OBJECT=50000
LOG_LEVEL=info

# API
API_PORT=3000
API_HOST=0.0.0.0
