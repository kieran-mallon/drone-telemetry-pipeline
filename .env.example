# ---------------------------------------------------------------------------
# Copy to .env when running the scripts, the processor or the API on the host.
# docker-compose.yml sets these for the containers itself.
#
# The difference between host and container values is only the hostname: the
# containers reach each other by service name, you reach them on localhost.
# ---------------------------------------------------------------------------

# Postgres
DATABASE_URL=postgres://drone:drone@localhost:5432/telemetry

# S3 is MinIO, SQS is ElasticMQ. Both unset in a real deployment, where the SDK
# resolves real AWS. AWS_ENDPOINT_URL is the fallback for both, which is what a
# single-endpoint emulator (see docker-compose.localstack.yml) wants instead.
AWS_REGION=eu-west-1
S3_ENDPOINT_URL=http://localhost:9000
SQS_ENDPOINT_URL=http://localhost:9324
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Pipeline wiring. The queue is named, not hardcoded to a URL: the URL is
# resolved at runtime via GetQueueUrl so the same config works against both a
# local queue server and real SQS.
RAW_BUCKET=drone-telemetry-raw
INGEST_QUEUE_NAME=drone-telemetry-ingest
# INGEST_QUEUE_URL=            # optional override, skips resolution

# Tuning
BATCH_SIZE=10
MAX_RECORDS_PER_OBJECT=50000
INSERT_CHUNK_SIZE=500
LOG_LEVEL=info
# Human-readable logs. On here because this file is for running on your own
# terminal; the containers leave it off and emit JSON, which is what you want
# when something else is parsing the output.
LOG_PRETTY=true

# API
API_PORT=3000
API_HOST=0.0.0.0
